<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive layers span 108dp, but the visible viewport is 72dp.
     Inset 18dp per side so the full master fits that viewport, as on iOS. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16.6667%"
    android:insetTop="16.6667%"
    android:insetRight="16.6667%"
    android:insetBottom="16.6667%">
    <bitmap
        android:src="@drawable/ic_launcher_foreground"
        android:gravity="fill"
        android:filter="true" />
</inset>
