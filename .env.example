# Local launch tools/options only; never bundled as an App asset.
# Edit public API URLs in lib/app/config/app_config.dart, then hot reload.
# Empty APP_ENV uses the Dart default (local in development, production in release).
# Optional APP_ENV override is a launch option and requires relaunch to change.
APP_ENV=
# Used by Android/USB/iOS/web fallbacks only when localApiBaseUrl is empty.
API_PORT=8000
# FLUTTER_BIN=flutter
# ADB_BIN=adb
# Do not put application secrets in Dart configuration, assets or --dart-define.
